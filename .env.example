# Port the HTTP server listens on.
PORT=8080

# Node environment. `development` relaxes the boot guards below.
NODE_ENV=development

# ── Inbound auth ─────────────────────────────────────────────────────────
# Shared bearer token: every /ops/*, /connections* request must send
#   Authorization: Bearer <SLACK_TOOL_TOKEN>
# hadron-server holds the same value as SLACK_TOOL_TOKEN.
# Required in production — the service refuses to start without it.
SLACK_TOOL_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────
# The tool's OWN database (never core's). Holds encrypted workspace tokens,
# the persist-before-ack event inbox, and idempotency records.
DATABASE_URL=postgresql://holger@localhost:5432/hadrontool_slack

# ── Secrets ──────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of workspace tokens at rest.
# Distinct from core's HADRON_ENCRYPTION_KEY by design. Required in production.
TOKEN_ENCRYPTION_KEY=

# ── Event plane (tool → core) ────────────────────────────────────────────
# Where normalized Slack events are POSTed (hadron-server's internal
# ingress, /internal/slack-events) and the bearer that call carries.
# Unset ⇒ events are logged + dropped WITHOUT inbox writes — an
# unconfigured consumer is deliberate, not an outage.
CORE_EVENTS_URL=
CORE_EVENTS_TOKEN=

# ── Socket Mode ──────────────────────────────────────────────────────────
# Set to `true` to disable the socket worker (ops plane still serves).
DISABLE_SOCKET_WORKER=

# ── Sending ──────────────────────────────────────────────────────────────
# Minimum gap between sends to the SAME channel, in ms (~1 msg/s per Slack's
# chat.postMessage guidance). The pacer never holds a request longer than
# 5s — beyond that it returns provider_rate_limited and core's sweep worker
# retries durably.
SLACK_SEND_GAP_MS=1000

# Minimum gap between get-history calls on the SAME connection, in ms —
# conversations.history has a tight per-method budget and the gap-backfill
# sweep hits it once per binding on reconnect.
SLACK_HISTORY_GAP_MS=1200

# Override the Web API origin (tests only).
SLACK_API_BASE=https://slack.com/api

# Max request body size accepted by the JSON parser.
MAX_BODY_SIZE=1mb
